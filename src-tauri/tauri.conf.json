{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wisp",
  "mainBinaryName": "wisp",
  "version": "1.1.0",
  "identifier": "com.wisp.assistant",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": false,
      "tooltip": "Wisp"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "SelectionHook.dll": "SelectionHook.dll"
    },
    "shortDescription": "Wisp",
    "longDescription": "选中文字即弹出的轻量 AI 划词助手",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
